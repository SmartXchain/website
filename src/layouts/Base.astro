---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import { SITE } from '../lib/site';

interface ArticleMeta {
  publishedTime: Date;
  modifiedTime?: Date;
  section: string;
  author: string;
  tags?: string[];
}

interface Props {
  title: string;
  description?: string;
  noHeader?: boolean;
  noFooter?: boolean;
  ogImage?: string;
  articleMeta?: ArticleMeta;
}

const {
  title,
  description = SITE.description,
  noHeader,
  noFooter,
  ogImage = '/og.svg',
  articleMeta,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const ogType = articleMeta ? 'article' : 'website';

const baseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Main feed`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {SITE.social.twitter && <meta name="twitter:site" content={`@${SITE.social.twitter}`} />}

    {
      articleMeta && (
        <>
          <meta property="article:published_time" content={articleMeta.publishedTime.toISOString()} />
          {articleMeta.modifiedTime && (
            <meta property="article:modified_time" content={articleMeta.modifiedTime.toISOString()} />
          )}
          <meta property="article:section" content={articleMeta.section} />
          <meta property="article:author" content={articleMeta.author} />
          {articleMeta.tags?.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }

    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} is:inline />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ViewTransitions />
  </head>
  <body>
    {!noHeader && <Header />}
    <main>
      <slot />
    </main>
    {!noFooter && <Footer />}
  </body>
</html>
