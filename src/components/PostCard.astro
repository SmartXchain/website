---
import type { Post } from '../lib/posts';
import { getSection } from '../lib/sections';
import { formatStamp } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const section = getSection(post.data.category);
const stamp = formatStamp(post.data.date);
---

<article class="group h-full border border-frontier-border bg-frontier-surface p-6 transition-colors hover:border-frontier-border-strong">
  <a href={`/posts/${post.slug}`} class="block">
    <div
      class="font-mono text-xs uppercase tracking-kicker"
      style={`color:${section.accentHex}`}
    >
      // {section.name}
    </div>
    <h3
      class="mt-3 font-display text-xl font-bold leading-tight text-white transition-colors group-hover:text-frontier-signal md:text-2xl"
    >
      {post.data.title}
    </h3>
    <p class="mt-2 text-sm text-frontier-text-muted">
      {post.data.excerpt}
    </p>
    <p class="ui-text mt-3">{stamp}</p>
  </a>
</article>
