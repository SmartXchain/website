---
import type { Post } from '../lib/posts';
import { getSection } from '../lib/sections';
import { formatShortDate, readTime } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const section = getSection(post.data.category);
---

<a
  href={`/posts/${post.slug}`}
  class="group block border-b border-frontier-border py-5"
>
  <div class="grid grid-cols-[80px_120px_1fr] items-baseline gap-4 md:grid-cols-[100px_140px_1fr_80px]">
    <div class="ui-text">{formatShortDate(post.data.date)}</div>
    <div
      class="font-mono text-xs uppercase tracking-kicker"
      style={`color:${section.accentHex}`}
    >
      {section.name}
    </div>
    <div class="font-display text-base font-semibold leading-snug text-frontier-text transition-colors group-hover:text-frontier-signal md:text-lg">
      {post.data.title}
    </div>
    <div class="hidden ui-text text-right md:block">
      {readTime(post.body)} min
    </div>
  </div>
</a>
