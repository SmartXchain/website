---
import { SITE } from '../lib/site';

interface Props {
  compact?: boolean;
  hideCopy?: boolean;
}
const { compact = false, hideCopy = false } = Astro.props;

const action = `https://buttondown.email/api/emails/embed-subscribe/${SITE.buttondownUsername}`;
const popupTarget = `https://buttondown.email/${SITE.buttondownUsername}`;
---

{
  compact ? (
    <form
      action={action}
      method="post"
      target="popupwindow"
      onsubmit={`window.open('${popupTarget}', 'popupwindow')`}
      class="flex w-full max-w-sm border border-frontier-border bg-frontier-bg"
    >
      <label class="sr-only" for="bd-email-compact">Email</label>
      <input
        id="bd-email-compact"
        type="email"
        name="email"
        required
        placeholder="your@email.com"
        autocomplete="email"
        class="flex-1 bg-transparent px-3 py-2 font-mono text-xs text-frontier-text placeholder:text-frontier-text-dim focus:outline-none"
      />
      <button
        type="submit"
        class="border-l border-frontier-border bg-frontier-signal px-4 py-2 font-mono text-xs font-semibold uppercase tracking-ui text-frontier-bg hover:opacity-90"
      >
        Subscribe
      </button>
    </form>
  ) : (
    <div class="border border-frontier-border bg-frontier-surface p-6 md:p-8">
      {!hideCopy && (
        <>
          <div class="kicker">// {SITE.newsletter.name}</div>
          <h3 class="mt-3 font-display text-2xl font-bold text-white md:text-3xl">
            Get the brief in your inbox.
          </h3>
          <p class="mt-3 max-w-prose text-frontier-text-muted">{SITE.newsletter.pitch}</p>
        </>
      )}
      <form
        action={action}
        method="post"
        target="popupwindow"
        onsubmit={`window.open('${popupTarget}', 'popupwindow')`}
        class={`${hideCopy ? '' : 'mt-6'} flex flex-col gap-3 sm:flex-row`}
      >
        <label class="sr-only" for="bd-email-full">Email</label>
        <input
          id="bd-email-full"
          type="email"
          name="email"
          required
          placeholder="your@email.com"
          autocomplete="email"
          class="flex-1 border border-frontier-border bg-frontier-bg px-4 py-3 font-mono text-sm text-frontier-text placeholder:text-frontier-text-dim focus:border-frontier-signal focus:outline-none"
        />
        <button
          type="submit"
          class="border border-frontier-signal bg-frontier-signal px-6 py-3 font-mono text-xs font-semibold uppercase tracking-ui text-frontier-bg hover:opacity-90"
        >
          Subscribe →
        </button>
      </form>
      {!hideCopy && (
        <p class="ui-text mt-4">// Free · double opt-in · unsubscribe anytime</p>
      )}
    </div>
  )
}
