---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroPost from '../components/HeroPost.astro';
import SignalSidebar from '../components/SignalSidebar.astro';
import PostCard from '../components/PostCard.astro';
import SignalOfWeek from '../components/SignalOfWeek.astro';
import { sections } from '../lib/sections';
import { sortByDateDesc } from '../lib/posts';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = sortByDateDesc(allPosts);

const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
const remainder = sorted.filter((p) => p.slug !== featured.slug);

const signalItems = remainder.slice(0, 4);

const latestPerCategory = sections
  .map((s) => remainder.find((p) => p.data.category === s.slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);
const categoryGrid = sortByDateDesc(latestPerCategory).slice(0, 3);

const signalOfWeek =
  remainder.find((p) => p.data.category === 'research') ?? remainder[0];
---

<Base title="SmartXChain — Signal from the frontier">
  <section class="container-wide grid gap-12 py-16 md:grid-cols-[2.2fr_1fr] md:py-20">
    <HeroPost post={featured} />
    <SignalSidebar items={signalItems} />
  </section>

  <section class="container-wide pb-16">
    <div class="kicker">// Across the Frontier</div>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {categoryGrid.map((p) => <PostCard post={p} />)}
    </div>
  </section>

  {signalOfWeek && <SignalOfWeek post={signalOfWeek} />}

  <section class="container-wide py-16">
    <div class="kicker">// Sections</div>
    <div class="mt-6 grid gap-3 md:grid-cols-3">
      {
        sections.map((s) => (
          <a
            href={`/${s.slug}`}
            class="group border border-frontier-border bg-frontier-surface p-5 transition-colors hover:border-frontier-border-strong"
          >
            <div
              class="font-mono text-xs uppercase tracking-kicker"
              style={`color:${s.accentHex}`}
            >
              // {s.slug}
            </div>
            <div class="mt-2 font-display text-xl font-bold text-white group-hover:text-frontier-signal">
              {s.name} →
            </div>
            <div class="mt-1 text-sm text-frontier-text-muted">{s.blurb}</div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
