---
const title = 'SmartXChain — Signal from the frontier';
const description =
  'A specialist publication for Web3, AI, and deep tech. Signal over noise.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-frontier-bg text-frontier-text font-sans antialiased">
    <main class="mx-auto max-w-wide px-[6vw] py-32">
      <p class="font-mono text-xs uppercase tracking-kicker text-frontier-signal">
        // SmartXChain · v0.0.1
      </p>
      <h1
        class="mt-6 max-w-[18ch] font-display text-5xl font-extrabold leading-[1.02] tracking-tight text-white md:text-7xl"
      >
        Signal from the frontier.
      </h1>
      <p class="mt-6 max-w-[60ch] text-lg text-frontier-text-muted">
        Coming soon. A specialist publication for Web3, AI, and deep tech.
      </p>
      <p
        class="mt-12 font-mono text-xs uppercase tracking-ui text-frontier-text-dim"
      >
        // build pipeline online · {new Date().toISOString().slice(0, 10)}
      </p>
    </main>
  </body>
</html>
