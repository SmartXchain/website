---
import Base from '../layouts/Base.astro';
import { sections } from '../lib/sections';

const palette: Array<[string, string]> = [
  ['bg', '#0a0e0c'],
  ['surface', '#0d1411'],
  ['surface-deep', '#050807'],
  ['border', '#1c2620'],
  ['border-strong', '#2a3a30'],
  ['signal', '#4ade80'],
  ['signal-deep', '#0a6b4e'],
  ['text', '#d8e6dc'],
  ['text-muted', '#b8c8be'],
  ['text-dim', '#6a8a7a'],
  ['danger', '#f87171'],
  ['warn', '#fbbf24'],
];
---

<Base
  title="Style guide — SmartXChain"
  description="Frontier design system reference."
>
  <div class="container-wide py-20">
    <p class="kicker">// design system reference</p>
    <h1 class="mt-4 font-display text-5xl font-extrabold tracking-tight text-frontier-text">
      Style guide
    </h1>
    <p class="mt-4 max-w-prose text-frontier-text-muted">
      Live reference of every visual primitive in the Frontier design language.
      Used for QA and onboarding new writers/contributors.
    </p>

    <!-- Palette -->
    <section class="mt-16 border-t border-frontier-border pt-12">
      <h2 class="kicker">// 01 — palette</h2>
      <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
        {
          palette.map(([name, hex]) => (
            <div class="border border-frontier-border">
              <div class="h-16" style={`background:${hex}`} />
              <div class="px-3 py-2 font-mono text-xs">
                <div class="text-frontier-text">{name}</div>
                <div class="text-frontier-text-dim">{hex}</div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Section accents -->
    <section class="mt-16 border-t border-frontier-border pt-12">
      <h2 class="kicker">// 02 — section accents</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {
          sections.map((s) => (
            <div class="border border-frontier-border p-4">
              <div
                class="font-mono text-xs uppercase tracking-kicker"
                style={`color:${s.accentHex}`}
              >
                // {s.slug}
              </div>
              <div class="mt-1 font-display text-2xl font-bold text-frontier-text">{s.name}</div>
              <div class="mt-1 text-sm text-frontier-text-muted">{s.blurb}</div>
              <div class="mt-2 font-mono text-xs text-frontier-text-dim">{s.accentHex}</div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Typography -->
    <section class="mt-16 border-t border-frontier-border pt-12">
      <h2 class="kicker">// 03 — typography</h2>
      <div class="mt-6 space-y-10">
        <div>
          <div class="ui-text">Display / Fraunces 800</div>
          <h3 class="font-display text-5xl font-extrabold tracking-tight text-frontier-text md:text-6xl">
            Signal from the frontier.
          </h3>
        </div>
        <div>
          <div class="ui-text">Headline / Fraunces 700</div>
          <h3 class="font-display text-3xl font-bold text-frontier-text">
            Solana's first real bank run was its best stress test
          </h3>
        </div>
        <div>
          <div class="ui-text">Dek / Inter 500</div>
          <p class="text-xl text-frontier-text">
            A $1.8B redemption cascade across three protocols held. Here's the
            post-mortem the validators don't want you to read.
          </p>
        </div>
        <div>
          <div class="ui-text">Body / Inter 400</div>
          <p class="max-w-prose text-base text-frontier-text">
            The new long-context model is the first to ship with a workable
            economic primitive: persistent identity across sessions. Builders
            are already wiring it to onchain wallets — and that changes who
            actually owns an agent.
          </p>
        </div>
        <div>
          <div class="ui-text">UI / IBM Plex Mono 500</div>
          <p class="font-mono text-xs uppercase tracking-kicker text-frontier-signal">
            // CHAIN WATCH · 23.05.26 · UPDATED 06:14 UTC
          </p>
        </div>
      </div>
    </section>

    <!-- Links -->
    <section class="mt-16 border-t border-frontier-border pt-12">
      <h2 class="kicker">// 04 — links &amp; CTAs</h2>
      <div class="mt-6 space-y-4 text-base">
        <p class="text-frontier-text">
          This is an example of <a
            href="#"
            class="text-frontier-signal underline decoration-frontier-signal/30 underline-offset-4 hover:decoration-frontier-signal"
            >an inline link</a
          > inside body text.
        </p>
        <p class="font-mono text-xs uppercase tracking-ui">
          <a href="#" class="text-frontier-signal hover:opacity-80">→ Call-to-action link</a>
        </p>
      </div>
    </section>

    <!-- Card -->
    <section class="mt-16 border-t border-frontier-border pt-12">
      <h2 class="kicker">// 05 — story card</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <article class="border border-frontier-border bg-frontier-surface p-6">
          <div
            class="font-mono text-xs uppercase tracking-kicker"
            style="color:#60a5fa"
          >
            // ai-lab
          </div>
          <h3
            class="mt-3 font-display text-xl font-bold leading-tight text-frontier-text"
          >
            The benchmark wars are over. Welcome to "evals as a service."
          </h3>
          <p class="mt-2 text-sm text-frontier-text-muted">
            Three startups are quietly pricing model behavior. The implications
            for procurement are larger than anyone is saying.
          </p>
          <p class="ui-text mt-3">23.05.26 · 09:45 UTC</p>
        </article>
        <article class="border border-frontier-border bg-frontier-surface p-6">
          <div
            class="font-mono text-xs uppercase tracking-kicker"
            style="color:#4ade80"
          >
            // chain-watch
          </div>
          <h3
            class="mt-3 font-display text-xl font-bold leading-tight text-frontier-text"
          >
            Coinbase quietly opens institutional staking in Europe
          </h3>
          <p class="mt-2 text-sm text-frontier-text-muted">
            The product launched without a press release. Here's why that
            matters more than the staking itself.
          </p>
          <p class="ui-text mt-3">23.05.26 · 06:12 UTC</p>
        </article>
        <article class="border border-frontier-border bg-frontier-surface p-6">
          <div
            class="font-mono text-xs uppercase tracking-kicker"
            style="color:#c084fc"
          >
            // deep-tech
          </div>
          <h3
            class="mt-3 font-display text-xl font-bold leading-tight text-frontier-text"
          >
            Fusion's grid moment isn't 2035. It's the next 18 months.
          </h3>
          <p class="mt-2 text-sm text-frontier-text-muted">
            Helion's first PPA, the DOE's quiet rule change, and a chart that
            should worry every utility CFO.
          </p>
          <p class="ui-text mt-3">23.05.26 · 07:18 UTC</p>
        </article>
      </div>
    </section>
  </div>
</Base>
