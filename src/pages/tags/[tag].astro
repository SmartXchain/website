---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { sortByDateDesc } from '../../lib/posts';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tags = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tags.add(tag);
  }
  return [...tags].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params as { tag: string };
const posts = sortByDateDesc(
  await getCollection(
    'posts',
    ({ data }) => !data.draft && data.tags.includes(tag),
  ),
);
---

<Base
  title={`#${tag} — SmartXChain`}
  description={`Posts tagged #${tag} on SmartXChain.`}
>
  <section class="container-wide py-16">
    <div class="kicker">// tag</div>
    <h1 class="mt-3 font-display text-5xl font-extrabold tracking-tight text-white md:text-6xl">
      #{tag}
    </h1>
    <p class="mt-4 max-w-prose text-lg text-frontier-text-muted">
      {posts.length} post{posts.length === 1 ? '' : 's'} tagged{' '}
      <code class="text-frontier-signal">#{tag}</code>.
    </p>

    <div class="mt-12">
      <div class="ui-text border-b border-frontier-border pb-3">// {posts.length} POSTS</div>
      {posts.map((p) => <PostRow post={p} />)}
    </div>

    <a
      href="/archive"
      class="ui-text mt-10 inline-block transition-colors hover:text-frontier-signal"
    >
      ← Browse the full archive
    </a>
  </section>
</Base>
